{
  "name": "leadforge",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test": "turbo test",
    "migrate": "cd packages/database && bunx prisma format && bunx prisma generate && bunx prisma migrate dev",
    "migrate:deploy": "cd packages/database && bunx prisma generate && bunx prisma migrate deploy",
    "db:studio": "cd packages/database && bunx prisma studio --config prisma.config.ts"
  },
  "devDependencies": {
    "@auto-it/first-time-contributor": "^11.3.6",
    "@biomejs/biome": "2.5.6",
    "@repo/typescript-config": "*",
    "@types/node": "^25.3.5",
    "turbo": "^2.8.14",
    "typescript": "^5.9.3",
    "ultracite": "7.2.5",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.14",
  "overrides": {
    "parse5": "^7.2.1"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
